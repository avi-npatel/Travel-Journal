# Copy this file to .env.local and fill in the two Supabase values.
# Both are safe to expose to browsers: what a visitor may do with them is
# decided by the row level security rules in supabase/migrations.

# Supabase dashboard → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard → Project Settings → API Keys → Publishable key
# (starts with "sb_publishable_"). The older "anon" key works here too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. The address the site is served from, used for link previews.
# On Vercel this is detected automatically; set it if you add a custom domain.
# NEXT_PUBLIC_SITE_URL=https://example.com
